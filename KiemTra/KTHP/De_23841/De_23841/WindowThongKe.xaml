<Window x:Class="De_23841.WindowThongKe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:De_23841"
        mc:Ignorable="d"
        Title="Thống kê" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <DataGrid x:Name="dgvHienThi" Grid.Row="5" Grid.ColumnSpan="2" AutoGenerateColumns="False" ColumnWidth="*">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã danh mục" Binding="{Binding MaDm}" />
                <DataGridTextColumn Header="Tên danh mục" Binding="{Binding TenDm}"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding TongTien, StringFormat=\{0:N0\}}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
