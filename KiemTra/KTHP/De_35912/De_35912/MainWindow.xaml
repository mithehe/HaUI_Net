<Window x:Class="De_35912.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:De_35912"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Thông tin quản lý nhân viên" HorizontalContentAlignment="Center" FontSize="18"
               FontWeight="Bold"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Mã nhân viên"/>
        <TextBox x:Name="txtMaNhanVien" Grid.Row="1" Grid.Column="1" Width="320" Margin="30,5,360,5" />

        <Label Grid.Row="2" Grid.Column="0" Content="Tên nhân viên"/>
        <TextBox x:Name="txtTenNhanVien" Grid.Row="2" Grid.Column="1" Width="320" Margin="30,5,360,5" />

        <Label Grid.Row="3" Grid.Column="0" Content="Ngày sinh"/>
        <TextBox x:Name="txtNgaySinh" Grid.Row="3" Grid.Column="1" Width="320" Margin="30,5,360,5" />

        <Label Grid.Row="4" Grid.Column="0" Content="Lương cơ bản"/>
        <TextBox x:Name="txtLuongCB" Grid.Row="4" Grid.Column="1" Width="320" Margin="30,5,360,5" />

        <Label Grid.Row="5" Grid.Column="0" Content="Phòng ban"/>
        <ComboBox x:Name="cboPhongBan" Grid.Row="5" Grid.Column="1" Width="320" Margin="30,5,360,5" />

        <DataGrid Grid.Row="6" Grid.ColumnSpan="2" AutoGenerateColumns="False" ColumnWidth="*" x:Name="dgvHienThi">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã nhân viên" Binding="{Binding MaNv}"/>
                <DataGridTextColumn Header="Tên nhân viên" Binding="{Binding TenNV}"/>
                <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh}"/>
                <DataGridTextColumn Header="Lương cơ bản" Binding="{Binding LuongCb}"/>
                <DataGridTextColumn Header="Phòng ban" Binding="{Binding MaPb}"/>
                <DataGridTextColumn Header="Lương" Binding="{Binding Luong, StringFormat=\{0:N0\}}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" x:Name="temp">
            <Button Template="{StaticResource temp}" x:Name="btnThem" Content="Thêm" Margin="10,5" Width="72" Height="28" Click="btnThem_Click" />
            <Button Template="{StaticResource temp}" x:Name="btnSua" Content="Sửa" Margin="10,5" Width="72" Height="28" Click="btnSua_Click"/>
            <Button Template="{StaticResource temp}" x:Name="btnXoa" Content="Xóa" Margin="10,5" Width="72" Height="28" Click="btnXoa_Click"/>
            <Button Template="{StaticResource temp}" x:Name="btnThongKe" Content="Thống kê" Margin="10,5" Width="72" Height="28"/>
        </StackPanel>
    </Grid>
</Window>
