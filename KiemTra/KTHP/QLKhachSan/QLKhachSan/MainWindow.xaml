<Window x:Class="QLKhachSan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLKhachSan"
        mc:Ignorable="d"
        Title="Quản lý khách sạn" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Mã phòng" Grid.Row="0" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtMaPhong" Grid.Row="0" Grid.Column="1" Width="320" Margin="5, 0, 320, 0"/>
        <Label Content="Loại phòng" Grid.Row="1" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtLoaiPhong" Grid.Row="1" Grid.Column="1" Width="320" Margin="5, 0, 320, 0"/>
        <Label Content="Giá thuê" Grid.Row="2" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtGiaThue" Grid.Row="2" Grid.Column="1" Width="320" Margin="5, 0, 320, 0"/>
        <Label Content="Trạng thái" Grid.Row="3" Grid.Column="0" FontSize="16"/>
        <ComboBox x:Name="cboTrangThai" Grid.Row="3" Grid.Column="1" Width="320" Margin="5, 0, 320, 0"/>

        <DataGrid x:Name="dgvHienThi" Grid.Row="4" Grid.ColumnSpan="2" AutoGenerateColumns="False" ColumnWidth="*" SelectionChanged="dgvHienThi_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phòng" Binding="{Binding MaPhong}"/>
                <DataGridTextColumn Header="Loại phòng" Binding="{Binding LoaiPhong}"/>
                <DataGridTextColumn Header="Giá thuê" Binding="{Binding GiaThue, StringFormat={}{0:N0}}"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" x:Name="temp">
            <Button Template="{StaticResource temp}" x:Name="btnThem" Content="Thêm" Width="72" Height="32" Margin="10, 5" Click="btnThem_Click"/>
            <Button Template="{StaticResource temp}" x:Name="btnSua" Content="Sửa" Width="72" Height="32" Margin="10, 5" Click="btnSua_Click"/>
            <Button Template="{StaticResource temp}" x:Name="btnXoa" Content="Xóa" Width="72" Height="32" Margin="10, 5" Click="btnXoa_Click"/>
            <Button Template="{StaticResource temp}" x:Name="btnTim" Content="Tìm" Width="72" Height="32" Margin="10, 5" Click="btnTim_Click"/>
        </StackPanel>
    </Grid>
</Window>
