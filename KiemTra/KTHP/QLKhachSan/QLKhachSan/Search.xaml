<Window x:Class="QLKhachSan.Search"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLKhachSan"
        mc:Ignorable="d"
        Title="Search" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <DataGrid x:Name="dgvHienThi" Grid.Row="4" Grid.ColumnSpan="2" AutoGenerateColumns="False" ColumnWidth="*">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phòng" Binding="{Binding MaPhong}"/>
                <DataGridTextColumn Header="Loại phòng" Binding="{Binding LoaiPhong}"/>
                <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding HoTen}"/>
                 <DataGridTextColumn Header="Ngày nhận phòng" Binding="{Binding NgayNhanPhong, StringFormat={}{0:dd/MM/yyyy}}"/>
                <DataGridTextColumn Header="Ngày trả phòng" Binding="{Binding NgayTraPhong, StringFormat={}{0:dd/MM/yyyy}}"/>
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat={}{0:N0}}"/>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
