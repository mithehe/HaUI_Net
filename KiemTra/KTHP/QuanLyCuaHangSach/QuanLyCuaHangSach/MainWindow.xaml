<Window x:Class="QuanLyCuaHangSach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyCuaHangSach"
        mc:Ignorable="d"
        Title="Quản lý bán sách" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Mã sách: " Grid.Row="0" Grid.Column="0" FontSize="16" Margin="0, 0, 20, 0"/>
        <TextBox x:Name="txtMaSach" Grid.Row="0" Grid.Column="1" Width="320" Margin="48,5,280,5" />

        <Label Content="Tên sách: " Grid.Row="1" Grid.Column="0" FontSize="16" Margin="0, 0, 20, 0"/>
        <TextBox x:Name="txtTenSach" Grid.Row="1" Grid.Column="1" Width="320" Margin="48,5,280,5" />

        <Label Content="Thể loại sách: " Grid.Row="2" Grid.Column="0" FontSize="16" Margin="0, 0, 20, 0"/>
        <ComboBox x:Name="cboTheLoai" Grid.Row="2" Grid.Column="1" Width="320" Margin="48,5,280,5" />

        <Label Content="Đơn giá: " Grid.Row="3" Grid.Column="0" FontSize="16" Margin="0, 0, 20, 0"/>
        <TextBox x:Name="txtDonGia" Grid.Row="3" Grid.Column="1" Width="320" Margin="48,5,280,5" />

        <Label Content="Số lượng tồn: " Grid.Row="4" Grid.Column="0" FontSize="16" Margin="0, 0, 20, 0"/>
        <TextBox x:Name="txtSoLuongTon" Grid.Row="4" Grid.Column="1" Width="320" Margin="48,5,280,5" />

        <DataGrid Grid.Row="5" Grid.ColumnSpan="2" ColumnWidth="*" x:Name="dgvHienThi" AutoGenerateColumns="False" SelectionChanged="dgvHienThi_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã sách" Binding="{Binding MaSach}" />
                <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" />
                <DataGridTextColumn Header="Mã thể loại" Binding="{Binding MaTheLoai}" />
                <DataGridTextColumn Header="Số lượng tồn" Binding="{Binding SoLuongTon}" />
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" />
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="temp">
            <Button Content="Thêm" Template="{StaticResource temp}" x:Name="btnThem" Width="72" Height="24" Margin="10, 5" Click="btnThem_Click"/>
            <Button Template="{StaticResource temp}" x:Name="btnSua" Content="Sửa" Width="72" Height="24" Margin="10, 5" Click="btnSua_Click"/>
            <Button Template="{StaticResource temp}" x:Name="btnXoa" Content="Xóa" Width="72" Height="24" Margin="10, 5" Click="btnXoa_Click"/>
            <Button Template="{StaticResource temp}" x:Name="btnThongKe" Content="Thống kê" Width="72" Height="24" Margin="10, 5" Click="btnThongKe_Click"/>
        </StackPanel>
    </Grid>
</Window>
