<Window x:Class="QuanLyCuaHangSach.Search"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyCuaHangSach"
        mc:Ignorable="d"
        Title="Danh sách bán sách" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <DataGrid Grid.Row="5" Grid.ColumnSpan="2" ColumnWidth="*" x:Name="dgvHienThi" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã sách" Binding="{Binding MaSach}" />
                <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" />
                <DataGridTextColumn Header="Tên thể loại" Binding="{Binding TenTheLoai}" />
                <DataGridTextColumn Header="Số lượng đã bán" Binding="{Binding SoLuongDaBan}" />
                <DataGridTextColumn Header="Tổng tiền đã bán" Binding="{Binding TongTienBanSach, StringFormat={}{0:N0}}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
