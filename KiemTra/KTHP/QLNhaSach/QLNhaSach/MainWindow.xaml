<Window x:Class="QLNhaSach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLNhaSach"
        mc:Ignorable="d"
        Title="Quản lý nhân viên" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Mã nhân viên:" Grid.Row="0" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtMaNV" Grid.Row="0" Grid.Column="1" Width="300" Margin="20, 2, 320, 0"/>

        <Label Content="Tên nhân viên:" Grid.Row="1" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtTenNV" Grid.Row="1" Grid.Column="1" Width="300" Margin="20, 2, 320, 0"/>

        <Label Content="Chức vụ:" Grid.Row="2" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtChucVu" Grid.Row="2" Grid.Column="1" Width="300" Margin="20, 2, 320, 0"/>

        <Label Content="Lương:" Grid.Row="3" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtLuong" Grid.Row="3" Grid.Column="1" Width="300" Margin="20, 2, 320, 0"/>

        <Label Content="Phòng ban:" Grid.Row="4" Grid.Column="0" FontSize="16"/>
        <ComboBox x:Name="cboPhongBan" Grid.Row="4" Grid.Column="1" Width="300" Margin="20, 2, 320, 0"/>

        <DataGrid Grid.Row="5" Grid.ColumnSpan="2" AutoGenerateColumns="False" ColumnWidth="*" x:Name="dgvHienThi" SelectionChanged="dgvHienThi_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã nhân viên" Binding="{Binding MaNv}"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}"/>
                <DataGridTextColumn Header="Chức vụ" Binding="{Binding ChucVu}"/>
                <DataGridTextColumn Header="Lương" Binding="{Binding Luong, StringFormat={}{0:N0}}"/>
                <DataGridTextColumn Header="Phòng ban" Binding="{Binding TenPhong}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" x:Name="temp">
            <Button x:Name="btnThem" Content="Thêm" Width="72" Height="32" Margin="10, 5" Click="btnThem_Click"/>
            <Button x:Name="btnSua" Content="Sửa" Width="72" Height="32" Margin="10, 5" Click="btnSua_Click"/>
            <Button x:Name="btnXoa" Content="Xóa" Width="72" Height="32" Margin="10, 5" Click="btnXoa_Click"/>
            <Button x:Name="btnTim" Content="Tìm" Width="72" Height="32" Margin="10, 5" Click="btnTim_Click"/>
        </StackPanel>
    </Grid>
</Window>
