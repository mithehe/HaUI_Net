<Window x:Class="De_7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:De_7"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="QUẢN LÝ DƯỢC PHẨM" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,10"/>

        <Label Content="Mã thuốc" Grid.Row="1" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtMaThuoc" Grid.Row="1" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="50, 5"></TextBox>
        
        <Label Content="Tên thuốc" Grid.Row="2" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtTenThuoc" Grid.Row="2" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="50, 5"></TextBox>
        
        <Label Content="Giá thuốc" Grid.Row="3" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtGiaThuoc" Grid.Row="3" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="50, 5"></TextBox>

        <Label Content="Số lượng" Grid.Row="4" Grid.Column="0" FontSize="16"/>
        <TextBox x:Name="txtSoLuong" Grid.Row="4" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="50, 5"></TextBox>

        <Label Content="Danh mục thuốc" Grid.Row="5" Grid.Column="0" FontSize="16"/>
        <ComboBox x:Name="cboDanhMuc" Grid.Row="5" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="50, 5">
        </ComboBox>

        <DataGrid x:Name="dgvHienThi" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" AutoGenerateColumns="False" ColumnWidth="*">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding MaThuoc}"  Header="Mã thuốc" />
                <DataGridTextColumn Binding="{Binding TenThuoc}" Header="Tên thuốc"/>
                <DataGridTextColumn Binding="{Binding MaDm}" Header="Danh mục thuốc"/>
                <DataGridTextColumn Binding="{Binding GiaBan}" Header="Giá bán"/>
                <DataGridTextColumn Binding="{Binding SoLuong}" Header="Số lượng"/>
                <DataGridTextColumn Binding="{Binding ThanhTien}" Header="Thành tiền"/>
            </DataGrid.Columns>   
        </DataGrid>

        <StackPanel Grid.ColumnSpan="2" Grid.Row="7" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Button x:Name="btnThem" Content="Thêm" Margin="20, 5" Height="32" Width="60" Click="btnThem_Click"/>
            <Button x:Name="btnSua" Content="Sửa" Margin="20, 5" Height="32" Width="60" Click="btnSua_Click" />
            <Button x:Name="btnXoa" Content="Xóa" Margin="20, 5" Height="32" Width="60" Click="btnXoa_Click"/>
            <Button x:Name="btnTim" Content="Tìm" Margin="20, 5" Height="32" Width="60 " Click="btnTim_Click"/>
        </StackPanel>
    </Grid>

</Window>
