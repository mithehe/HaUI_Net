<Window x:Class="De_7.WindowTimKiem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:De_7"
        mc:Ignorable="d"
        Title="WindowTimKiem" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <DataGrid x:Name="dgThongKe" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã danh mục" Binding="{Binding MaDM}" Width="*"/>
                <DataGridTextColumn Header="Tên danh mục" Binding="{Binding TenDM}" Width="1.5*"/>
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat=\{0:N0\}}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
