<Window x:Class="De_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:De_3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Border BorderBrush="Green" BorderThickness ="2" Margin="10">
        <Grid Background="LightBlue">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Thông tin nhân viên" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="2" Foreground="DarkOrange" FontWeight="Bold" FontSize="35"/>

            <Label Content="Mã nhân viên:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="16"/>
            <TextBox x:Name="txtMaNV" Grid.Row="1" Grid.Column="1" Margin="10,10,500,10" />

            <Label Content="Họ tên:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="16"/>
            <TextBox x:Name="txtHoTen" Grid.Row="2" Grid.Column="1" Margin="10,10,180,10" />

            <Label Content="Giới tính:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontSize="16"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="10,10,200,10">
                <RadioButton x:Name="rbNam" Content="Nam" Margin="0,5,20,0" IsChecked="True"/>
                <RadioButton x:Name="rbNu" Content="Nữ" Margin="0,5,0,5" />
            </StackPanel>

            <Label Content="Số tiền bán hàng:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontSize="16"/>
            <TextBox x:Name="txtSoTienBanHang" Grid.Row="4" Grid.Column="1" Margin="10,10,500,10" />

            <Label x:Name="dsNhanVien" Content="Danh sách nhân viên:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontSize="16" Grid.ColumnSpan="2"/>

            <Border BorderBrush="Green" BorderThickness="2" Margin="10"  Grid.Row="6" Grid.Column="0"  Grid.ColumnSpan="2">
                <DataGrid AutoGenerateColumns="False" ColumnWidth="*" x:Name="dgvHienThi">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding MaNV}" Header="Mã nhân viên" />
                        <DataGridTextColumn Binding="{Binding HoTen}" Header="Họ tên" />
                        <DataGridTextColumn Binding="{Binding GioiTinh}" Header="Giới tính" />
                        <DataGridTextColumn Binding="{Binding SoTienBanHang}" Header="Số tiền bán hàng" />
                        <DataGridTextColumn Binding="{Binding TienHoaHong}" Header="Số tiền hoa hồng" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="7" Grid.ColumnSpan ="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Template="{StaticResource themTemp}" x:Name="btnThem" Content="Thêm" Width="70" Height="30" Margin="10" Click="btnThem_Click"/>
                <Button Template="{StaticResource win2Temp}" x:Name="btnWin2" Content="Window 2" Width="70" Height="30" Margin="10" Click="btnWin2_Click"/>
            </StackPanel>


        </Grid>
    </Border>

</Window>
